{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/api/(.*).geojson",
      "headers": [{ "key": "Content-Type", "value": "application/geo+json; charset=utf-8" }]
    }
  ]
}
